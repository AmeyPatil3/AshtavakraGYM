# Database Connection (SQLite in development, PostgreSQL in production)
DATABASE_URL="file:./prisma/dev.db"

# JWT Authentication Secret Key (Generate a random 64-character string in production)
JWT_SECRET="production-jwt-secret-ashtavakra-somaiya-2026-secure-key"

# Domain Restrictions (Strictly restricted to @somaiya.edu)
ALLOWED_DOMAINS="somaiya.edu"

# Production System Admin Credentials
ADMIN_EMAIL="admin@somaiya.edu"
ADMIN_INITIAL_PASSWORD="Admin@123"

# Google OAuth 2.0 Credentials (Set NEXT_PUBLIC_ENABLE_GOOGLE_AUTH="true" to activate in future versions)
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH="false"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
